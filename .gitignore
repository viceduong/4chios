# Xcode
build/
DerivedData/
*.xcodeproj
*.xcworkspace
!*.xcodeproj/project.pbxproj
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Some machines have a global `*.md` ignore (e.g. ~/.gitignore_global). Repository
# documentation is part of the project, so re-include markdown explicitly.
# A repository .gitignore takes precedence over the global excludes file.
!*.md
!docs/**/*.md

# Generated by XcodeGen (CI injects build-time values into it)
App/Info.plist

# SwiftPM
.build/
.swiftpm/
Package.resolved.bak

# macOS
.DS_Store
._*

# Secrets — never commit tokens
.remote-pi-token.txt
.env
*.pem
*.p12
*.mobileprovision

# Build artifacts / reproducibility manifests
artifacts/
build-manifest.json

# Editors
.vscode/
.idea/
